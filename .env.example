# Public mobile configuration only. Never put the TikTok client secret here.
EXPO_PUBLIC_API_BASE_URL=https://viraly-ai.onrender.com
# Local development only. Must match backend VIRALY_DEV_TOKEN and stay empty in production.
EXPO_PUBLIC_VIRALY_DEV_TOKEN=
EXPO_PUBLIC_TIKTOK_CONNECT_URL=https://api.example.com/oauth/tiktok/start
EXPO_PUBLIC_TIKTOK_CALLBACK_URL=viralyai://auth/tiktok
# Facultatif : le backend Render et le retour adapté à Expo sont utilisés par défaut.
EXPO_PUBLIC_GOOGLE_CONNECT_URL=
EXPO_PUBLIC_GOOGLE_CALLBACK_URL=
